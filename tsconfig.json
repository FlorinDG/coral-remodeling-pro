{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next.nosync/types/**/*.ts",
    ".next.nosync/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next.nosync",
    "scripts",
    "mcp-server",
    "tests",
    "**/* [0-9].ts",
    "**/* [0-9].tsx",
    "**/* copy.ts",
    "**/* copy.tsx",
    "**/*.tmp"
  ]
}
